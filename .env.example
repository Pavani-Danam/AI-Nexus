# ===================================================================
# AI-NEXUS ENVIRONMENT VARIABLES TEMPLATE (PRODUCTION / STAGING)
# DO NOT COMMIT SENSITIVE VALUES TO VERSION CONTROL
# ===================================================================

# --- Spring Profile ---
SPRING_PROFILES_ACTIVE=prod

# --- Database Credentials ---
DB_URL=jdbc:postgresql://postgres-db:5432/ainexus_prod
DB_USERNAME=ainexus_admin
DB_PASSWORD=your_secure_database_password_here
DB_POOL_MAX=20
DB_POOL_MIN_IDLE=5

# --- JWT Security ---
# Ensure JWT_SECRET is a strong 256-bit+ base64-encoded string
JWT_SECRET=your_jwt_signing_secret_min_32_characters_long
JWT_EXPIRATION_MS=86400000

# --- Gemini AI ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004
GEMINI_TEMPERATURE=0.2
GEMINI_MAX_OUTPUT_TOKENS=2048
GEMINI_TIMEOUT_SECONDS=30

# --- Pinecone Vector Database ---
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_ENVIRONMENT=us-east-1
PINECONE_INDEX=ainexus-index
PINECONE_TIMEOUT_SECONDS=20

# --- File Storage & Uploads ---
MAX_FILE_SIZE=25MB
MAX_REQUEST_SIZE=30MB
UPLOAD_DIR=/var/ainexus/uploads

# --- RAG Parameters ---
RAG_MAX_CONTEXT_CHARS=8000
RAG_SIMILARITY_THRESHOLD=0.70
RAG_TOP_K=5

# --- Agent & Workflow Limits ---
AGENT_MAX_ITERATIONS=10
AGENT_MAX_STEPS=8
AGENT_MAX_REPLANS=3
AGENT_TIMEOUT_SECONDS=120
WORKFLOW_MAX_CONCURRENCY=10
WORKFLOW_RETRY_LIMIT=3
WORKFLOW_RETRY_DELAY_MS=2000

# --- CORS Allowed Origins (Comma-separated) ---
CORS_ALLOWED_ORIGINS=https://ainexus.app,https://admin.ainexus.app
