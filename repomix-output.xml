                        value={step.name}
                        onChange={(e) => handleStepChange(idx, 'name', e.target.value)}
                        style={{ flex: 1, padding: '6px', border: '1px solid #cbd5e1', borderRadius: '4px', fontSize: '12px' }}
                        required
                      />
                      <select
                        value={step.type}
